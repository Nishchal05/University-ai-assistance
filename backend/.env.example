# Backend Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# LLM Configuration
# Set LLM_MODE=mock for offline deterministic testing and evaluation without Ollama
# Set LLM_MODE=ollama for live Ollama inference
LLM_MODE=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Storage paths
SQLITE_DB_PATH=backend/data/university.db
CHROMA_PERSIST_DIR=backend/data/chroma
DOCUMENTS_STORAGE_DIR=backend/data/documents
